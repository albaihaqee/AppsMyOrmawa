<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2C4EEF"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <!-- Top Bar with Back Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="16dp">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_arrow_left"
                app:tint="#FFFFFF"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_semibold"
                android:gravity="center"
                android:text="Open Recruitment"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <View
                android:layout_width="24dp"
                android:layout_height="24dp" />
        </LinearLayout>

        <!-- Chip Group -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:gravity="center">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_oprec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:singleLine="true"
                app:chipSpacingHorizontal="8dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_pengurus"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="171dp"
                    android:layout_height="wrap_content"
                    android:text="Oprec Pengurus"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:textColor="@color/chip_text_color_blue"
                    android:fontFamily="@font/poppins_medium"
                    app:chipBackgroundColor="@color/chip_background_color_blue"
                    app:chipCornerRadius="20dp"
                    app:chipStrokeWidth="0dp"
                    android:checked="true" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_kepanitiaan"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="171dp"
                    android:layout_height="wrap_content"
                    android:text="Oprec Kepanitiaan"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:textColor="@color/chip_text_color_blue"
                    android:fontFamily="@font/poppins_medium"
                    app:chipBackgroundColor="@color/chip_background_color_blue"
                    app:chipCornerRadius="20dp"
                    app:chipStrokeWidth="0dp" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>
    </LinearLayout>

    <!-- ProgressBar (TAMBAHAN) -->
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"/>

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_oprec"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F8F8F8"
        android:paddingTop="12dp"
        android:clipToPadding="false"/>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layout_empty_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/txt_empty_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Belum Ada Rekruitmen"
            android:textColor="#757575"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_medium"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rekruitmen akan segera hadir!"
            android:textColor="#9E9E9E"
            android:textSize="13sp"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center"/>
    </LinearLayout>

</LinearLayout>
