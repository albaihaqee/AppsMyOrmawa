<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog"
    android:padding="0dp">

    <!-- Poster + Close Button -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardUseCompatPadding="true">

            <ImageView
                android:id="@+id/img_dialog_poster"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"/>
        </androidx.cardview.widget.CardView>

        <ImageView
            android:id="@+id/btn_close_dialog"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_close"
            android:background="@drawable/bg_close_button"
            android:padding="6dp"
            app:tint="#FFFFFF"
            android:layout_gravity="end|top"
            android:layout_margin="12dp"/>
    </FrameLayout>

    <!-- Content Scrollable -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Title -->
            <TextView
                android:id="@+id/tv_dialog_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Judul Event"
                android:textColor="#1A1A1A"
                android:textSize="18sp"
                android:fontFamily="@font/poppins_bold"
                android:layout_marginBottom="16dp"
                android:maxLines="2"
                android:ellipsize="end"/>

            <!-- Info Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_detail_info"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <!-- Date -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_calendar"
                        app:tint="#2C4EEF"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:id="@+id/tv_dialog_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="20 November 2025"
                        android:textSize="13sp"
                        android:textColor="#1A1A1A"/>
                </LinearLayout>

                <!-- Time -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_clock"
                        app:tint="#2C4EEF"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:id="@+id/tv_dialog_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="09:00 - 17:00 WIB"
                        android:textSize="13sp"
                        android:textColor="#1A1A1A"/>
                </LinearLayout>

                <!-- Location -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_location"
                        app:tint="#FF5252"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:id="@+id/tv_dialog_location"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gedung JTI Lt.2"
                        android:textSize="13sp"
                        android:textColor="#1A1A1A"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deskripsi"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_semibold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tv_dialog_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#4A4A4A"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"/>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
