<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    android:backgroundTint="#FFFFFF"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Judul Notifikasi -->
        <TextView
            android:id="@+id/tv_meeting_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pemberitahuan Rapat HMJ-TI"
            android:textColor="#1A1A1A"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_semibold"
            android:layout_marginBottom="8dp"/>

        <!-- Agenda -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_document"
                app:tint="#757575"
                android:layout_marginEnd="8dp"
                android:layout_gravity="center_vertical"/>

            <TextView
                android:id="@+id/tv_meeting_agenda"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Evaluasi program kerja dan pembahasan agenda baru"
                android:textColor="#4A4A4A"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_regular"
                android:lineSpacingExtra="2dp"/>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginVertical="10dp"/>

        <!-- Tanggal & Waktu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_calendar"
                    app:tint="#2C4EEF"
                    android:layout_marginEnd="6dp"
                    android:layout_gravity="center_vertical"/>

                <TextView
                    android:id="@+id/tv_meeting_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="25 Nov 2024"
                    android:textColor="#4A4A4A"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_medium"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_clock"
                    app:tint="#2C4EEF"
                    android:layout_marginEnd="6dp"
                    android:layout_gravity="center_vertical"/>

                <TextView
                    android:id="@+id/tv_meeting_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="09:00 - 11:00"
                    android:textColor="#4A4A4A"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_medium"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Lokasi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_location"
                app:tint="#FF5252"
                android:layout_marginEnd="6dp"
                android:layout_gravity="center_vertical"/>

            <TextView
                android:id="@+id/tv_meeting_location"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ruang Meeting Lantai 3"
                android:textColor="#4A4A4A"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_medium"/>
        </LinearLayout>

        <!-- Time Posted (Waktu Notifikasi Masuk) -->
        <TextView
            android:id="@+id/tv_posted_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dikirim 1 jam lalu"
            android:textColor="#A6A6A6"
            android:textSize="10sp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/poppins_regular"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
