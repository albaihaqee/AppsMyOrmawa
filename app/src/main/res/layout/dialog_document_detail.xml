<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog"
    android:padding="24dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Detail Dokumen"
            android:textColor="#1A1A1A"
            android:textSize="18sp"
            android:fontFamily="@font/poppins_semibold"/>

        <ImageView
            android:id="@+id/btn_close_dialog"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#757575"
            android:contentDescription="Close"/>
    </LinearLayout>

    <!-- Document Icon Large -->
    <LinearLayout
        android:id="@+id/layout_dialog_icon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/bg_document_icon"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp">

        <ImageView
            android:id="@+id/iv_dialog_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_document"
            app:tint="#FFFFFF"/>
    </LinearLayout>

    <!-- Document Name -->
    <TextView
        android:id="@+id/tv_dialog_document_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Proposal Kegiatan 2024.pdf"
        android:textColor="#1A1A1A"
        android:textSize="16sp"
        android:fontFamily="@font/poppins_semibold"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>

    <!-- Details Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_detail_info"
        android:padding="16dp"
        android:layout_marginBottom="20dp">

        <!-- Jenis Dokumen -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:text="Jenis Dokumen"
                android:textColor="#757575"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_regular"/>

            <TextView
                android:id="@+id/tv_dialog_document_type"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PDF"
                android:textColor="#1A1A1A"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_medium"/>
        </LinearLayout>

        <!-- Ukuran File -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:text="Ukuran File"
                android:textColor="#757575"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_regular"/>

            <TextView
                android:id="@+id/tv_dialog_file_size"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="2.5 MB"
                android:textColor="#1A1A1A"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_medium"/>
        </LinearLayout>

        <!-- Tanggal Upload -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="110dp"
                android:layout_height="wrap_content"
                android:text="Tanggal Upload"
                android:textColor="#757575"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_regular"/>

            <TextView
                android:id="@+id/tv_dialog_upload_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="25 November 2024"
                android:textColor="#1A1A1A"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_medium"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Download Button -->
    <androidx.cardview.widget.CardView
        android:id="@+id/btn_download"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        android:backgroundTint="#2C4EEF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_download"
                app:tint="#FFFFFF"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unduh Dokumen"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_semibold"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>