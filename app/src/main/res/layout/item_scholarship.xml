<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Poster 3:4 Ratio -->
        <androidx.cardview.widget.CardView
            android:layout_width="75dp"
            android:layout_height="100dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/img_scholarship_poster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="#E0E0E0"
                android:contentDescription="Scholarship Poster"/>
        </androidx.cardview.widget.CardView>

        <!-- Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <!-- Title -->
            <TextView
                android:id="@+id/txt_scholarship_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Beasiswa LPDP"
                android:textColor="#1A1A1A"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_semibold"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginBottom="5dp"/>

            <!-- Provider -->
            <TextView
                android:id="@+id/txt_scholarship_provider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lembaga Pengelola Dana Pendidikan (LPDP)"
                android:textColor="#8C8C8C"
                android:textSize="10sp"
                android:fontFamily="@font/poppins_regular"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginBottom="8dp"/>

            <!-- Deadline -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_calendar"
                    app:tint="#2C4EEF"
                    android:layout_marginEnd="4dp"/>

                <TextView
                    android:id="@+id/txt_scholarship_deadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="25 Dec 2025"
                    android:textColor="#2C4EEF"
                    android:textSize="10sp"
                    android:fontFamily="@font/poppins_medium"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Arrow Right Icon -->
        <ImageView
            android:id="@+id/img_arrow_right"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_arrow_right"
            app:tint="#8C8C8C"
            android:layout_marginStart="8dp"
            android:layout_gravity="center_vertical"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>