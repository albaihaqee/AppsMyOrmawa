<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">

            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:id="@+id/img_organization_logo_detail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_graduation_filled"
                    android:padding="16dp"
                    android:background="@drawable/shape_organization_logo"
                    app:tint="#FFFFFF" />
            </FrameLayout>

            <TextView
                android:id="@+id/txt_organization_name_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="BEM KM"
                android:textColor="#1A1A1A"
                android:textSize="18sp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_category_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lembaga"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_medium"
                app:chipBackgroundColor="#E8EEFF"
                android:textColor="#2C4EEF"
                app:chipCornerRadius="6dp"
                app:chipMinHeight="28dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📝 Deskripsi"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="#1A1A1A"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/txt_description_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Badan Eksekutif Mahasiswa"
            android:fontFamily="@font/poppins_regular"
            android:textColor="#666666"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎯 Visi"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="#1A1A1A"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/txt_vision_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Belum ada visi"
            android:fontFamily="@font/poppins_regular"
            android:textColor="#666666"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎪 Misi"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="#1A1A1A"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/txt_mission_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Belum ada misi"
            android:fontFamily="@font/poppins_regular"
            android:textColor="#666666"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📧 Email"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="#1A1A1A"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/txt_email_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="-"
            android:fontFamily="@font/poppins_regular"
            android:textColor="#666666"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📞 Contact Person"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="#1A1A1A"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/txt_contact_person_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="-"
            android:fontFamily="@font/poppins_regular"
            android:textColor="#666666"
            android:textSize="13sp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btn_close_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tutup"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="#FFFFFF"
            android:background="@drawable/shape_button_primary"
            android:textAllCaps="false"
            android:paddingVertical="12dp" />
    </LinearLayout>
</ScrollView>